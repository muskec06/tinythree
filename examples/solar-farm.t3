// A small unlicensed solar plant: 6x4 tilted panels, an inverter and a fence line.
scene bg=#9cc9ff cam=14,8,14 look=0,0,0 orbit shadows fog=#9cc9ff,25,60 dur=12s
hemi #ffffff #5a6b3a .6
sun 8,15,6 2.5 area=16
mat ground #6f8f4a r=1
mat panel #2a4d8f r=.3 m=.2
mat frame #b8bec6 m=.8 r=.35
plane 60 ground floor
group row hidden
  box p 2.6,.06,1.6 @0,1.1,0 rx=25 panel
  cyl leg .05,1 @0,.5,.4 frame
  cyl leg2 .05,1.4 @0,.7,-.4 frame
use row r2 @-7.5,0,-6 grid=6,4,3,4
box inverter 1.2,1.6,.8 @9,.8,0 #e8e8e8
box fence .05,1.2,24 @11,.6,0 frame
anim cam orbit 24s
