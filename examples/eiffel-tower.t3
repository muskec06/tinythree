// Eiffel Tower, Paris — 1 unit ≈ 30 m
scene bg=#cfe3f5 cam=12,4.5,12 look=0,5,0 orbit shadows fog=#cfe3f5,25,70 dur=12s
hemi #ffffff #6b7d5a .9
sun 6,14,8 2.5 area=8
mat iron #6a5240 r=.8 m=.3
mat lattice #8a6d55 wire
mat deck #3e3027 r=.7
mat beacon #ffd27a glow=3
plane 60 #7c9a5c floor
group legs ry=45
  box leg .45,2.4,.45 @0,1.1,0 iron rz=22 radial=4,1.9
torus arch 1.15,.07 @0,.85,0 iron arc=180 ry=90 radial=4,1.45
box deck1 2.5,.16,2.5 @0,2.25,0 deck
cyl mid 1.05,1.65,1.9 @0,3.25,0 seg=4 ry=45 lattice
cyl midcore .95,1.5,1.9 @0,3.25,0 seg=4 ry=45 iron
box deck2 1.5,.12,1.5 @0,4.25,0 deck
cyl top .2,1,5.2 @0,6.9,0 seg=4 ry=45 lattice
cyl topcore .16,.9,5.2 @0,6.9,0 seg=4 ry=45 iron
box deck3 .45,.14,.45 @0,9.55,0 deck
cyl spire .03,.07,1.1 @0,10.15,0 iron
sphere light .09 @0,10.75,0 beacon
anim cam orbit 24s
anim beacon glow wave 2 1.5s
